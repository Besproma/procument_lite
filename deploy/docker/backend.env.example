# 复制为受控运行环境文件后填写；不要提交真实凭据。
APP_ENV=production
DATABASE_DSN=postgresql://assistant_user:change-me@opengauss.internal:5432/procurement
MODEL_BASE_URL=http://model-gateway.internal/v1
MODEL_NAME=采购助手模型
MODEL_API_KEY=
PROCUREMENT_HOTLINE_TEXT=未找到相关采购栏目，请联系采购热线。
CORS_ALLOWED_ORIGINS=["http://localhost:8080"]

# 下面是已确认的默认边界，按目标环境压测结果调整。
RUN_DEADLINE_SECONDS=100
DELEGATE_ATTEMPT_TIMEOUT_SECONDS=15
DELEGATE_MAX_ATTEMPTS=2
CHECKPOINT_TTL_HOURS=24
KNOWLEDGE_CACHE_TTL_SECONDS=600
PRODUCT_PAGE_SIZE=3
HTTP_MAX_CONNECTIONS=500
HTTP_MAX_KEEPALIVE_CONNECTIONS=100
HTTP_MAX_RESPONSE_BYTES=10485760
