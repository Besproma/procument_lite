# systemd 原生部署使用的环境变量模板；请放入 /etc/procurement-assistant/backend.env。
APP_ENV=production
DATABASE_DSN=postgresql://assistant_user:change-me@127.0.0.1:5432/procurement
MODEL_BASE_URL=http://127.0.0.1:9000/v1
MODEL_NAME=采购助手模型
MODEL_API_KEY=
PROCUREMENT_HOTLINE_TEXT=未找到相关采购栏目，请联系采购热线。
CORS_ALLOWED_ORIGINS=["http://procurement-assistant.internal"]
